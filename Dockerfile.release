# Complete official runtime for the separate HACS/live-API release trial.
FROM ghcr.io/home-assistant/home-assistant:2026.9.4@sha256:3e6710a7ab2a61311d9d899b719f6c3657791c63e8f4942cec4ebc42401d6b76

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace
COPY custom_components/public_transport_victoria ./custom_components/public_transport_victoria
COPY scripts/release-check.py ./scripts/release-check.py
ENTRYPOINT ["python", "scripts/release-check.py"]
